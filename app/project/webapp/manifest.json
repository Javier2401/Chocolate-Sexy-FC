{
  "_version": "1.84.0",
  "sap.app": {
    "id": "chocolatesexy.project",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "Chocolate Sexy",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "95df9ca6-630e-457a-b618-68a56dece05e"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/football/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.147.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "chocolatesexy.project.i18n.i18n",
          "supportedLocales": [
            "",
            "en"
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "chocolatesexy.project.view",
        "async": true,
        "viewPath": "chocolatesexy.project.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteSquad",
          "pattern": "squad",
          "target": [
            "TargetSquad"
          ]
        },
        {
          "name": "RouteCalendar",
          "pattern": "calendar",
          "target": [
            "TargetCalendar"
          ]
        },
        {
          "name": "RouteLeaderboard",
          "pattern": "leaderboard",
          "target": [
            "TargetLeaderboard"
          ]
        },
        {
          "name": "RouteStats",
          "pattern": "stats",
          "target": [
            "TargetStats"
          ]
        },
        {
          "name": "RouteSurveys",
          "pattern": "surveys",
          "target": [
            "TargetSurveys"
          ]
        },
        {
          "name": "RouteSettings",
          "pattern": "settings",
          "target": [
            "TargetSettings"
          ]
        },
        {
          "name": "RouteProfile",
          "pattern": "profile",
          "target": [
            "TargetProfile"
          ]
        },
        {
          "name": "RouteCookiePolicy",
          "pattern": "cookie-policy",
          "target": [
            "TargetCookiePolicy"
          ]
        },
        {
          "name": "RoutePrivacyPolicy",
          "pattern": "privacy-policy",
          "target": [
            "TargetPrivacyPolicy"
          ]
        },
        {
          "name": "RouteTermsOfUse",
          "pattern": "terms-of-use",
          "target": [
            "TargetTermsOfUse"
          ]
        }

      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "main.Main"
        },
        "TargetCalendar": {
          "id": "Calendar",
          "name": "pages.Calendar"
        },
        "TargetLeaderboard": {
          "id": "Leaderboard",
          "name": "pages.Leaderboard"
        },
        "TargetSquad": {
          "id": "Squad",
          "name": "pages.Squad"
        },
        "TargetStats": {  
          "id": "Stats",
          "name": "pages.Stats"
        },
        "TargetSurveys": {
          "id": "Surveys",
          "name": "pages.Surveys"
        },
        "TargetSettings": {
          "id": "Settings",
          "name": "pages.Settings"
        },
        "TargetProfile": {
          "id": "Profile",
          "name": "pages.Profile"
        },
        "TargetCookiePolicy": {
          "id": "CookiePolicy",
          "name": "pages.CookiePolicy"
        },
        "TargetPrivacyPolicy": {
          "id": "PrivacyPolicy",
          "name": "pages.PrivacyPolicy"
        },
        "TargetTermsOfUse": {
          "id": "TermsOfUse",
          "name": "pages.TermsOfUse"
        }  
      }
      
    },
    "rootView": {
      "viewName": "chocolatesexy.project.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
