                                                    </HBox>
                                                    <VBox class="calMatchInfo" alignItems="Center">
                                                        <Text text="Dom, 13 Sep 2026 · 17:00" class="calInfoText"/>
                                                        <Text text="📍 Campo Municipal" class="calInfoText"/>
                                                    </VBox>
                                                </VBox>
                                            </VBox>

                                            <VBox class="calMonthGroup">
                                                <HBox class="calMonthSeparator">
                                                    <Text text="Octubre 2026" class="calMonthSepLabel"/>
