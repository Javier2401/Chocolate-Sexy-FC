                                            <Text text="3º · 42 pts" class="rivalInfoVal"/>
                                        </HBox>
                                        <HBox class="rivalInfoRow" alignItems="Center">
                                            <Text text="📈" class="rivalInfoEmoji"/>
                                            <Text text="Últimos 3:" class="rivalInfoLabel"/>
                                            <HBox class="formBadgesRow" alignItems="Center">
                                                <VBox class="formBadge formL" alignItems="Center" justifyContent="Center">
                                                    <Text text="D" class="formBadgeText"/>
                                                </VBox>
                                                <VBox class="formBadge formD" alignItems="Center" justifyContent="Center">
                                                    <Text text="E" class="formBadgeText"/>
                                                </VBox>
                                                <VBox class="formBadge formW" alignItems="Center" justifyContent="Center">
                                                    <Text text="V" class="formBadgeText"/>
                                                </VBox>
                                            </HBox>
                                        </HBox>
                                        <HBox class="rivalInfoRow" alignItems="Center">
                                            <Text text="🆚" class="rivalInfoEmoji"/>
                                            <Text text="Historial:" class="rivalInfoLabel"/>
                                            <Text text="3V · 1E · 2D" class="rivalInfoVal"/>
                                        </HBox>
                                        <HBox class="rivalInfoRow" alignItems="Center">
                                            <Text text="⚡" class="rivalInfoEmoji"/>
                                            <Text text="Su racha:" class="rivalInfoLabel"/>
                                            <Text text="Sin ganar 3 partidos" class="rivalInfoVal"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox class="calSeasonArea">
                            <HBox class="calSeasonRow">
                                <VBox class="calMidCol">
                                    <VBox class="calSeasonBlock">
                                        <HBox class="calSeasonBlockHeader">
                                            <HBox class="calSeasonBlockTitleArea">
                                                <core:Icon src="sap-icon://calendar" class="calSeasonBlockIcon"/>
                                                <Text text="{i18n>calendar.season.2026-27}" class="calSeasonBlockTitle"/>
                                            </HBox>
                                            <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                                        </HBox>

                                        <VBox class="calSeasonContent" id="seasonContent2627">
                                            <VBox class="calMonthGroup">
                                                <HBox class="calMonthSeparator">
                                                    <Text text="Septiembre 2026" class="calMonthSepLabel"/>
                                                </HBox>
                                                <VBox class="calMatchCard">
                                                    <HBox class="calMatchTop" justifyContent="SpaceBetween" alignItems="Center">
                                                        <Text text="J1 · Liga" class="calJornada"/>
                                                        <Text text="PENDIENTE" class="calBadge calPendiente"/>
