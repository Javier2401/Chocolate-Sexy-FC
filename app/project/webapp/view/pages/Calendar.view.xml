                                                        <Text text="VICTORIA" class="calBadge calVictoria"/>
                                                    </HBox>
                                                    <HBox class="calTeamsRow" justifyContent="Center" alignItems="Center">
                                                        <VBox class="calTeamBox" alignItems="Center">
                                                            <Image src="images/logo.png" class="calTeamLogo" densityAware="false"/>
                                                            <Text text="Chocolate Sexy" class="calTeamName"/>
                                                        </VBox>
                                                        <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                            <Text text="2 - 1" class="calScoreText"/>
                                                        </VBox>
                                                        <VBox class="calTeamBox" alignItems="Center">
                                                            <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                <Text text="RV" class="calTeamInitials"/>
                                                            </VBox>
                                                            <Text text="Real Valencia" class="calTeamName"/>
                                                        </VBox>
                                                    </HBox>
                                                    <VBox class="calMatchInfo" alignItems="Center">
                                                        <Text text="Dom, 14 Sep 2025 · 17:00" class="calInfoText"/>
                                                        <Text text="📍 Campo Municipal" class="calInfoText"/>
                                                    </VBox>
                                                </VBox>
                                                </VBox>
                                        </VBox>
                                    </VBox>
                                </VBox>
                                <VBox class="calRightCol">
                                    <VBox class="calMiniCalsPanel" id="miniCal2526"/>
                                </VBox>
                            </HBox>

                        </VBox>
                        </HBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
