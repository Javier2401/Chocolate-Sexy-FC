<mvc:View
    controllerName="chocolatesexy.project.controller.pages.Calendar"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">
                    <HBox wrap="Wrap" class="calGrid">

                        <VBox class="calLeftCol">

                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://history" class="matchWidgetIcon"/>
                                    <Text text="{i18n>main.lastMatch}" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center" visible="{cal>/hayUltimo}">
                                    <Text text="Jornada {cal>/ultimoPartido/jornada}" class="matchJornada"/>
                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%">
                                        <VBox class="matchTeamBox" alignItems="Center">
                                            <Image src="images/escudo.png" class="matchTeamLogo"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                        <VBox class="matchCenterBox" alignItems="Center" justifyContent="Center">
                                            <HBox class="matchScoreBox" alignItems="Center" justifyContent="Center">
                                                <Text text="{cal>/ultimoPartido/golesNuestros}" class="matchScoreNum"/>
                                                <Text text=" – " class="matchScoreDash"/>
                                                <Text text="{cal>/ultimoPartido/golesRival}" class="matchScoreNum"/>
                                            </HBox>
                                        </VBox>
                                        <VBox class="matchTeamBox" alignItems="Center">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{cal>/ultimoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{cal>/ultimoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>
                                    <VBox class="matchInfoDetails" alignItems="Center" width="100%">
                                        <Text text="{cal>/ultimoPartido/fechaTexto}" class="matchInfoText"/>
                                        <Text text="📍 {cal>/ultimoPartido/ubicTxt}" class="matchInfoText"/>
                                    </VBox>
                                    <HBox class="mvpBox" alignItems="Center" width="100%" visible="{cal>/ultimoPartido/hayMvp}">
                                        <Text text="🏆" class="mvpEmoji"/>
                                        <VBox class="mvpInfo">
                                            <Text text="Chocolate MVP" class="mvpLabel"/>
                                            <Text text="{cal>/ultimoPartido/mvpNombre} · {cal>/ultimoPartido/mvpPosicion}" class="mvpName"/>
                                        </VBox>
                                        <VBox class="mvpRatingBadge" alignItems="Center" justifyContent="Center">
                                            <Text text="{cal>/ultimoPartido/mvpRating}" class="mvpRatingText"/>
                                        </VBox>
                                    </HBox>
                                    <HBox class="matchStatsRow" width="100%" visible="{cal>/ultimoPartido/hayStats}">
                                        <VBox class="matchStatItem" alignItems="Center">
                                            <Text text="{cal>/ultimoPartido/posesionTexto}" class="matchStatVal"/>
                                            <Text text="Posesión" class="matchStatLbl"/>
                                        </VBox>
                                        <VBox class="matchStatItem" alignItems="Center">
                                            <Text text="{cal>/ultimoPartido/tiros}" class="matchStatVal"/>
                                            <Text text="Tiros" class="matchStatLbl"/>
                                        </VBox>
                                        <VBox class="matchStatItem" alignItems="Center">
                                            <Text text="{cal>/ultimoPartido/corners}" class="matchStatVal"/>
                                            <Text text="Corners" class="matchStatLbl"/>
                                        </VBox>
                                        <VBox class="matchStatItem" alignItems="Center">
                                            <Text text="{cal>/ultimoPartido/amarillas}" class="matchStatVal"/>
                                            <Text text="Amarillas" class="matchStatLbl"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <Text text="No hay partidos jugados aún." class="calNoData"
                                      visible="{= !${cal>/hayUltimo} }"/>
                            </VBox>

                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://future" class="matchWidgetIcon"/>
                                    <Text text="{i18n>main.nextMatch}" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center" visible="{cal>/hayProximo}">
                                    <Text text="Jornada {cal>/proximoPartido/jornada}" class="matchJornada"/>
                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%">
                                        <VBox class="matchTeamBox" alignItems="Center">
                                            <Image src="images/escudo.png" class="matchTeamLogo"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                        <VBox class="matchCenterBox" alignItems="Center" justifyContent="Center">
                                            <Text text="VS" class="matchVsText"/>
                                        </VBox>
                                        <VBox class="matchTeamBox" alignItems="Center">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{cal>/proximoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{cal>/proximoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>
                                    <VBox class="matchInfoDetails" alignItems="Center" width="100%">
                                        <HBox class="matchInfoRow" justifyContent="Center" wrap="Wrap">
                                            <Text text="📅 {cal>/proximoPartido/fechaCorta}" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ {cal>/proximoPartido/hora}" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="📍 {cal>/proximoPartido/ubicTxt}" class="matchInfoText"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                                <VBox class="calNoDataBox" alignItems="Center" justifyContent="Center"
                                      visible="{= !${cal>/hayProximo} }">
                                    <Text text="No hay próximos partidos" class="calNoDataMsg"/>
                                </VBox>
                            </VBox>

                        </VBox>

                        <VBox class="calSeasonArea">

                            <HBox class="calSeasonRow">
                                <VBox class="calMidCol">
                                    <VBox class="calSeasonBlock">
                                        <HBox class="calSeasonBlockHeader">
                                            <HBox class="calSeasonBlockTitleArea">
                                                <core:Icon src="sap-icon://calendar" class="calSeasonBlockIcon"/>
                                                <Text text="{i18n>calendar.season.2026-27}" class="calSeasonBlockTitle"/>
                                            </HBox>
                                            <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                                        </HBox>
                                        <VBox class="calSeasonContent">
                                            <List items="{cal>/partidos2627}" showSeparators="None" showNoData="false">
                                                <CustomListItem>

                                                    <HBox class="calMonthSeparator" visible="{cal>isHeader}">
                                                        <VBox class="calMonthSepLine"/>
                                                        <Text text="{cal>mesLabel}" class="calMonthSepLabel"/>
                                                    </HBox>

                                                    <VBox class="calMatchCard" visible="{= !${cal>isHeader} }">
                                                        <HBox class="calMatchTop" justifyContent="SpaceBetween" alignItems="Center">
                                                            <Text text="Jornada {cal>jornada} · Liga" class="calJornada"/>
                                                            <Text text="VICTORIA"  class="calBadge calVictoria"  visible="{cal>esVictoria}"/>
                                                            <Text text="EMPATE"    class="calBadge calEmpate"    visible="{cal>esEmpate}"/>
                                                            <Text text="DERROTA"   class="calBadge calDerrota"   visible="{cal>esDerrota}"/>
                                                            <Text text="PENDIENTE" class="calBadge calPendiente" visible="{cal>esPendiente}"/>
                                                        </HBox>
                                                        <!-- VISITANTE: Chocolate Sexy izquierda, Rival derecha -->
                                                        <HBox class="calTeamsRow" justifyContent="SpaceBetween" alignItems="Start" visible="{= !${cal>esLocal} }">
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <Image src="images/escudo.png" class="calTeamLogo"/>
                                                                <Text text="Chocolate Sexy" class="calTeamName"/>
                                                            </VBox>
                                                            <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                                <Text text="{cal>marcador}" class="calScoreText"/>
                                                            </VBox>
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                    <Text text="{cal>rivalIniciales}" class="calTeamInitials"/>
                                                                </VBox>
                                                                <Text text="{cal>rivalNombre}" class="calTeamName" wrapping="true"/>
                                                            </VBox>
                                                        </HBox>
                                                        <!-- LOCAL: Rival izquierda, Chocolate Sexy derecha -->
                                                        <HBox class="calTeamsRow" justifyContent="SpaceBetween" alignItems="Start" visible="{cal>esLocal}">
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                    <Text text="{cal>rivalIniciales}" class="calTeamInitials"/>
                                                                </VBox>
                                                                <Text text="{cal>rivalNombre}" class="calTeamName" wrapping="true"/>
                                                            </VBox>
                                                            <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                                <Text text="{cal>marcador}" class="calScoreText"/>
                                                            </VBox>
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <Image src="images/escudo.png" class="calTeamLogo"/>
                                                                <Text text="Chocolate Sexy" class="calTeamName"/>
                                                            </VBox>
                                                        </HBox>
                                                        <VBox class="calMatchInfo" alignItems="Center">
                                                            <Text text="{cal>fechaTexto}" class="calInfoText"/>
                                                            <Text text="📍 {cal>ubicTxt}" class="calInfoText"/>
                                                        </VBox>
                                                    </VBox>

                                                </CustomListItem>
                                            </List>
                                            <VBox class="calNoDataBox" alignItems="Center" justifyContent="Center"
                                                  visible="{= !${cal>/hayPartidos2627} }">
                                                <Text text="No hay información disponible" class="calNoDataMsg"/>
                                            </VBox>
                                        </VBox>
                                    </VBox>
                                </VBox>
                                <VBox class="calRightCol">
                                    <VBox class="calMiniCalsPanel" id="miniCal2627"/>
                                </VBox>
                            </HBox>

                            <!-- TEMPORADA 2025-26 -->
                            <HBox class="calSeasonRow">
                                <VBox class="calMidCol">
                                    <VBox class="calSeasonBlock">
                                        <HBox class="calSeasonBlockHeader">
                                            <HBox class="calSeasonBlockTitleArea">
                                                <core:Icon src="sap-icon://calendar" class="calSeasonBlockIcon"/>
                                                <Text text="{i18n>calendar.season.2025-26}" class="calSeasonBlockTitle"/>
                                            </HBox>
                                            <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                                        </HBox>
                                        <VBox class="calSeasonContent">
                                            <List items="{cal>/partidos2526}" showSeparators="None" showNoData="false">
                                                <CustomListItem>

                                                    <HBox class="calMonthSeparator" visible="{cal>isHeader}">
                                                        <Text text="{cal>mesLabel}" class="calMonthSepLabel"/>
                                                    </HBox>

                                                    <VBox class="calMatchCard" visible="{= !${cal>isHeader} }">
                                                        <HBox class="calMatchTop" justifyContent="SpaceBetween" alignItems="Center">
                                                            <Text text="Jornada {cal>jornada} · Liga" class="calJornada"/>
                                                            <Text text="VICTORIA"  class="calBadge calVictoria"  visible="{cal>esVictoria}"/>
                                                            <Text text="EMPATE"    class="calBadge calEmpate"    visible="{cal>esEmpate}"/>
                                                            <Text text="DERROTA"   class="calBadge calDerrota"   visible="{cal>esDerrota}"/>
                                                            <Text text="PENDIENTE" class="calBadge calPendiente" visible="{cal>esPendiente}"/>
                                                        </HBox>
                                                        
                                                        <HBox class="calTeamsRow" justifyContent="SpaceBetween" alignItems="Start" visible="{= !${cal>esLocal} }">
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <Image src="images/escudo.png" class="calTeamLogo"/>
                                                                <Text text="Chocolate Sexy" class="calTeamName"/>
                                                            </VBox>
                                                            <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                                <Text text="{cal>marcador}" class="calScoreText"/>
                                                            </VBox>
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                    <Text text="{cal>rivalIniciales}" class="calTeamInitials"/>
                                                                </VBox>
                                                                <Text text="{cal>rivalNombre}" class="calTeamName" wrapping="true"/>
                                                            </VBox>
                                                        </HBox>

                                                        <HBox class="calTeamsRow" justifyContent="SpaceBetween" alignItems="Start" visible="{cal>esLocal}">
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                    <Text text="{cal>rivalIniciales}" class="calTeamInitials"/>
                                                                </VBox>
                                                                <Text text="{cal>rivalNombre}" class="calTeamName" wrapping="true"/>
                                                            </VBox>
                                                            <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                                <Text text="{cal>marcador}" class="calScoreText"/>
                                                            </VBox>
                                                            <VBox class="calTeamBox" alignItems="Center">
                                                                <Image src="images/escudo.png" class="calTeamLogo"/>
                                                                <Text text="Chocolate Sexy" class="calTeamName"/>
                                                            </VBox>
                                                        </HBox>
                                                        <VBox class="calMatchInfo" alignItems="Center">
                                                            <Text text="{cal>fechaTexto}" class="calInfoText"/>
                                                            <Text text="📍 {cal>ubicTxt}" class="calInfoText"/>
                                                        </VBox>
                                                    </VBox>

                                                </CustomListItem>
                                            </List>
                                            <VBox class="calNoDataBox" alignItems="Center" justifyContent="Center"
                                                  visible="{= !${cal>/hayPartidos2526} }">
                                                <Text text="No hay información disponible" class="calNoDataMsg"/>
                                            </VBox>
                                        </VBox>
                                    </VBox>
                                </VBox>
                                <VBox class="calRightCol">
                                    <VBox class="calMiniCalsPanel" id="miniCal2526"/>
                                </VBox>
                            </HBox>

                        </VBox>

                    </HBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>
</mvc:View>