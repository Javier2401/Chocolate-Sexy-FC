                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="VFC" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="VFC United" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>

                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <HBox justifyContent="Center" alignItems="Center" class="matchInfoRow">
                                            <Text text="📅 Dom, 22 Feb" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ 18:00" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="📍 Estadio Nuevo" class="matchInfoText"/>
                                        </HBox>
                                    </VBox>

                                    <HBox class="mvpBox" alignItems="Center" width="100%">
                                        <Text text="🏆" class="mvpEmoji"/>
                                        <VBox class="mvpInfo">
                                            <Text text="Chocolate MVP" class="mvpLabel"/>
                                            <Text text="Cristhian · Defensa" class="mvpName"/>
                                        </VBox>
                                        <VBox class="mvpRatingBadge" alignItems="Center" justifyContent="Center">
                                            <Text text="8.2" class="mvpRatingText"/>
