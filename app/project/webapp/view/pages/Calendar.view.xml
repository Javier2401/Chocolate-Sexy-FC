<mvc:View
    controllerName="chocolatesexy.project.controller.pages.Calendar"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

      
            <VBox class="scheduleContainer">

                <HBox class="matchCard" justifyContent="SpaceBetween" alignItems="Center">

                    <VBox class="matchInfo">
                        <Text text="Liga · Jornada 12" class="matchCompetition"/>
                        <Text text="Chocolate Sexy vs Real Valencia" class="matchTeams"/>
                        <Text text="Domingo · 18:00" class="matchDate"/>
                        <Text text="Campo Municipal" class="matchLocation"/>
                    </VBox>

                    <VBox class="matchStatusBox" alignItems="Center">
                        <Text text="PRÓXIMO" class="matchStatus"/>
                    </VBox>

                </HBox>

                <HBox class="matchCard" justifyContent="SpaceBetween" alignItems="Center">

                    <VBox class="matchInfo">
                        <Text text="Copa · Cuartos" class="matchCompetition"/>
                        <Text text="Yellow FC vs Chocolate Sexy" class="matchTeams"/>
                        <Text text="Sábado · 20:30" class="matchDate"/>
                        <Text text="Estadio Central" class="matchLocation"/>
                    </VBox>

                    <VBox class="matchStatusBox" alignItems="Center">
                        <Text text="3 DÍAS" class="matchCountdown"/>
                    </VBox>

                </HBox>

                <HBox class="matchCard" justifyContent="SpaceBetween" alignItems="Center">

                    <VBox class="matchInfo">
                        <Text text="Amistoso" class="matchCompetition"/>
                        <Text text="Chocolate Sexy vs Águilas City" class="matchTeams"/>
                        <Text text="Viernes · 21:00" class="matchDate"/>
                        <Text text="Campo Norte" class="matchLocation"/>
                    </VBox>

                    <VBox class="matchStatusBox" alignItems="Center">
                        <Text text="PENDIENTE" class="matchPending"/>
                    </VBox>

                </HBox>

            </VBox>


                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>
            
            </VBox>
        </content>
    </Page>

</mvc:View>