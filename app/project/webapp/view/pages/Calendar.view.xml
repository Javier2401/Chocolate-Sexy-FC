                                                    <HBox class="calMatchTop" justifyContent="SpaceBetween" alignItems="Center">
                                                        <Text text="J2 · Liga" class="calJornada"/>
                                                        <Text text="PENDIENTE" class="calBadge calPendiente"/>
                                                    </HBox>
                                                    <HBox class="calTeamsRow" justifyContent="Center" alignItems="Center">
                                                        <VBox class="calTeamBox" alignItems="Center">
                                                            <Image src="images/logo.png" class="calTeamLogo" densityAware="false"/>
                                                            <Text text="Chocolate Sexy" class="calTeamName"/>
                                                        </VBox>
                                                        <VBox class="calScoreBox" alignItems="Center" justifyContent="Center">
                                                            <Text text="- : -" class="calScoreText"/>
                                                        </VBox>
                                                        <VBox class="calTeamBox" alignItems="Center">
                                                            <VBox class="calTeamCircle" alignItems="Center" justifyContent="Center">
                                                                <Text text="DS" class="calTeamInitials"/>
                                                            </VBox>
                                                            <Text text="Deportivo Sur" class="calTeamName"/>
                                                        </VBox>
                                                    </HBox>
                                                    <VBox class="calMatchInfo" alignItems="Center">
                                                        <Text text="Dom, 11 Oct 2026 · 17:00" class="calInfoText"/>
                                                        <Text text="📍 Estadio Central" class="calInfoText"/>
                                                    </VBox>
                                                </VBox>
                                            </VBox>
                                        </VBox>
                                    </VBox>
                                </VBox>
                                <VBox class="calRightCol">
                                    <VBox class="calMiniCalsPanel" id="miniCal2627"/>
                                </VBox>
                            </HBox>

                            <HBox class="calSeasonRow">
                                <VBox class="calMidCol">
                                    <VBox class="calSeasonBlock">
                                        <HBox class="calSeasonBlockHeader">
                                            <HBox class="calSeasonBlockTitleArea">
                                                <core:Icon src="sap-icon://calendar" class="calSeasonBlockIcon"/>
                                                <Text text="{i18n>calendar.season.2025-26}" class="calSeasonBlockTitle"/>
                                            </HBox>
                                            <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                                        </HBox>

                                        <VBox class="calSeasonContent" id="seasonContent2526">
                                            <VBox class="calMonthGroup">
                                                <HBox class="calMonthSeparator">
                                                    <Text text="Septiembre 2025" class="calMonthSepLabel"/>
                                                </HBox>
                                                <VBox class="calMatchCard">
                                                    <HBox class="calMatchTop" justifyContent="SpaceBetween" alignItems="Center">
