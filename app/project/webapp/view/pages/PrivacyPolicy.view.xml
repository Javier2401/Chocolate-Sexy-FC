<mvc:View
    controllerName="chocolatesexy.project.controller.pages.PrivacyPolicy"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">

                    <VBox class="legalPageCard">

                        <HBox class="newsWidgetHeader2">
                            <Text text="{i18n>legal.privacy.title}" class="legalPageTitle"/>
                        </HBox>

                        <VBox class="legalPageBody">
                            <Text text="{i18n>legal.privacy.updated}" class="legalPageUpdated"/>
                            <FormattedText htmlText="{i18n>legal.privacy.content}"/>
                        </VBox>

                    </VBox>

                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>
            
            </VBox>
        </content>
    </Page>

</mvc:View>