<mvc:View
    controllerName="chocolatesexy.project.controller.pages.Stats"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="lbPageContent pageContent">

                    <VBox class="stCard stSeasonBlock" id="statsCard2627">
                        <HBox class="stCardHeader" justifyContent="SpaceBetween" alignItems="Center">
                            <VBox class="stHeaderBalancer"/>
                            <HBox class="stHeaderCenter" alignItems="Center" renderType="Bare">
                                <core:Icon src="sap-icon://activity-2" class="stHeaderIcon"/>
                                <Text text="{i18n>stats.season.2026-27}" class="stTitle"/>
                            </HBox>
                            <Button id="statsToggle2627"
                                    icon="sap-icon://slim-arrow-up"
                                    class="navIconBtn stCollapseBtn"
                                    press="onToggleStats2627"/>
                        </HBox>
                        <VBox class="stSeasonContent" id="statsContent2627" width="100%">
                            <VBox class="calNoDataBox lbNoDataHidden">
                                <Text text="{i18n>stats.noData}" class="calNoDataMsg"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <HBox class="stBottomRow" alignItems="Start" renderType="Bare">

                        <HBox class="stSidePanel stSidePanelRight" renderType="Bare"/>

                        <VBox class="stCard stSeasonBlock" id="statsCard2526">
                            <HBox class="stCardHeader" justifyContent="SpaceBetween" alignItems="Center">
                                <VBox class="stHeaderBalancer"/>
                                <HBox class="stHeaderCenter" alignItems="Center" renderType="Bare">
                                    <core:Icon src="sap-icon://activity-2" class="stHeaderIcon"/>
                                    <Text text="{i18n>stats.season.2025-26}" class="stTitle"/>
                                </HBox>
                                <Button id="statsToggle2526"
                                        icon="sap-icon://slim-arrow-up"
                                        class="navIconBtn stCollapseBtn"
                                        press="onToggleStats2526"/>
                            </HBox>
                            <VBox class="stSeasonContent" id="statsContent2526" width="100%">
                                <VBox class="calNoDataBox lbNoDataHidden">
                                    <Text text="{i18n>stats.noData}" class="calNoDataMsg"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox class="stSidePanel stSidePanelLeft" renderType="Bare">

                            <VBox class="stAwardCard" id="awardGoleador">
                                <HBox class="stAwardHeader" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://competitor" class="stAwardIcon"/>
                                    <Text id="awardGoleadorTitle" text="Máximo Goleador" class="stAwardTitle"/>
                                </HBox>
                                <VBox class="stAwardContent" id="awardGoleadorContent"/>
                            </VBox>

                            <VBox class="stAwardCard" id="awardAsistente">
                                <HBox class="stAwardHeader" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://add-product" class="stAwardIcon"/>
                                    <Text id="awardAsistenteTitle" text="Máximo Asistente" class="stAwardTitle"/>
                                </HBox>
                                <VBox class="stAwardContent" id="awardAsistenteContent"/>
                            </VBox>

                        </VBox>

                    </HBox>

                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>

</mvc:View>