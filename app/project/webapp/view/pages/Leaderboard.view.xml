<mvc:View
    controllerName="chocolatesexy.project.controller.pages.Leaderboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent lbPageContent">

                    <HBox class="lbSeasonRow" alignItems="Start" width="100%">
                        <VBox class="lbSeasonLeftSlot">
                            <VBox class="lbEvoSpacer"/>
                            <VBox class="calMejorEvoBlock lbMiniEvoCard lbMiniEvoHidden"/>
                            <VBox class="calPeorEvoBlock lbMiniEvoCard lbMiniEvoHidden"/>
                        </VBox>

                        <VBox class="lbCard calSeasonBlock">
                            <HBox class="lbCardHeader calSeasonBlockHeader">
                                <HBox class="calSeasonBlockTitleArea">
                                    <core:Icon src="sap-icon://soccer" class="lbHeaderIcon calSeasonBlockIcon"/>
                                    <Text text="{i18n>leaderboard.season.2026-27}" class="lbTitle calSeasonBlockTitle"/>
                                </HBox>
                                <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                            </HBox>
                            <VBox class="lbSeasonContent" width="100%">
                                <VBox class="calNoDataBox lbNoDataHidden">
                                    <Text text="{i18n>leaderboard.noData}" class="calNoDataMsg"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox class="lbEvoCard calEvoBlock"/>
                    </HBox>

                    <HBox class="lbSeasonRow" alignItems="Start" width="100%">
                        <VBox class="lbSeasonLeftSlot">
                            <VBox class="lbEvoSpacer"/>
                            <VBox class="calMejorEvoBlock lbMiniEvoCard lbMiniEvoHidden"/>
                            <VBox class="calPeorEvoBlock lbMiniEvoCard lbMiniEvoHidden"/>
                        </VBox>

                        <VBox class="lbCard calSeasonBlock">
                            <HBox class="lbCardHeader calSeasonBlockHeader">
                                <HBox class="calSeasonBlockTitleArea">
                                    <core:Icon src="sap-icon://soccer" class="lbHeaderIcon calSeasonBlockIcon"/>
                                    <Text text="{i18n>leaderboard.season.2025-26}" class="lbTitle calSeasonBlockTitle"/>
                                </HBox>
                                <Button icon="sap-icon://navigation-up-arrow" class="calSeasonToggleBtn" press="onToggleSeasonBlock"/>
                            </HBox>
                            <VBox class="lbSeasonContent" width="100%">
                                <VBox class="calNoDataBox lbNoDataHidden">
                                    <Text text="{i18n>leaderboard.noData}" class="calNoDataMsg"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox class="lbEvoCard calEvoBlock"/>
                    </HBox>

                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>

</mvc:View>