<mvc:View
    controllerName="chocolatesexy.project.controller.pages.Squad"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">
                    <VBox class="sqWidget">

                        <HBox class="sqWidgetHeader">
                            <core:Icon src="sap-icon://people-connected" class="sqWidgetIcon"/>
                            <Text text="{i18n>squad.title}" class="sqWidgetTitle"/>
                        </HBox>

                        <VBox class="sqWidgetBody">

                            <VBox class="sqPositionGroup" visible="{= ${squad>/entrenadores/length} > 0 }">
                                <HBox class="sqPositionLabelRow">
                                    <Text text="Entrenador" class="sqPositionLabel"/>
                                </HBox>
                                <HBox class="sqPlayerGrid" items="{squad>/entrenadores}">
                                    <VBox class="sqPlayerCard">
                                        <VBox class="sqPlayerImgBox">
                                            <Image src="{squad>foto}" class="sqPlayerImg"/>
                                        </VBox>
                                        <VBox class="sqPlayerInfo">
                                            <Text text="{squad>dorsal}" class="sqPlayerDorsal"/>
                                            <Text text="{squad>nombreCamiseta}" class="sqPlayerName"/>
                                            <Text text="{squad>posicion}" class="sqPlayerPos"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox class="sqPositionGroup" visible="{= ${squad>/porteros/length} > 0 }">
                                <HBox class="sqPositionLabelRow">
                                    <Text text="Portero" class="sqPositionLabel"/>
                                </HBox>
                                <HBox class="sqPlayerGrid" items="{squad>/porteros}">
                                    <VBox class="sqPlayerCard">
                                        <VBox class="sqPlayerImgBox">
                                            <Image src="{squad>foto}" class="sqPlayerImg"/>
                                        </VBox>
                                        <VBox class="sqPlayerInfo">
                                            <Text text="{squad>dorsal}" class="sqPlayerDorsal"/>
                                            <Text text="{squad>nombreCamiseta}" class="sqPlayerName"/>
                                            <Text text="{squad>posicion}" class="sqPlayerPos"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox class="sqPositionGroup" visible="{= ${squad>/defensas/length} > 0 }">
                                <HBox class="sqPositionLabelRow">
                                    <Text text="Defensas" class="sqPositionLabel"/>
                                </HBox>
                                <HBox class="sqPlayerGrid" items="{squad>/defensas}">
                                    <VBox class="sqPlayerCard">
                                        <VBox class="sqPlayerImgBox">
                                            <Image src="{squad>foto}" class="sqPlayerImg"/>
                                        </VBox>
                                        <VBox class="sqPlayerInfo">
                                            <Text text="{squad>dorsal}" class="sqPlayerDorsal"/>
                                            <Text text="{squad>nombreCamiseta}" class="sqPlayerName"/>
                                            <Text text="{squad>posicion}" class="sqPlayerPos"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox class="sqPositionGroup" visible="{= ${squad>/centrocampistas/length} > 0 }">
                                <HBox class="sqPositionLabelRow">
                                    <Text text="Centrocampistas" class="sqPositionLabel"/>
                                </HBox>
                                <HBox class="sqPlayerGrid" items="{squad>/centrocampistas}">
                                    <VBox class="sqPlayerCard">
                                        <VBox class="sqPlayerImgBox">
                                            <Image src="{squad>foto}" class="sqPlayerImg"/>
                                        </VBox>
                                        <VBox class="sqPlayerInfo">
                                            <Text text="{squad>dorsal}" class="sqPlayerDorsal"/>
                                            <Text text="{squad>nombreCamiseta}" class="sqPlayerName"/>
                                            <Text text="{squad>posicion}" class="sqPlayerPos"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox class="sqPositionGroup" visible="{= ${squad>/delanteros/length} > 0 }">
                                <HBox class="sqPositionLabelRow">
                                    <Text text="Delanteros" class="sqPositionLabel"/>
                                </HBox>
                                <HBox class="sqPlayerGrid" items="{squad>/delanteros}">
                                    <VBox class="sqPlayerCard">
                                        <VBox class="sqPlayerImgBox">
                                            <Image src="{squad>foto}" class="sqPlayerImg"/>
                                        </VBox>
                                        <VBox class="sqPlayerInfo">
                                            <Text text="{squad>dorsal}" class="sqPlayerDorsal"/>
                                            <Text text="{squad>nombreCamiseta}" class="sqPlayerName"/>
                                            <Text text="{squad>posicion}" class="sqPlayerPos"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>

                        </VBox>
                    </VBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>

</mvc:View>