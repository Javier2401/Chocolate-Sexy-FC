<mvc:View
    controllerName="chocolatesexy.project.controller.main.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">
                    <HBox wrap="Wrap" class="mainGrid">

                        <!-- ══════════════════════════════
                             IZQUIERDA: Último Post
                        ══════════════════════════════ -->
                        <VBox class="leftCol">
                            <VBox class="lastPostWidget">
                                <HBox class="newsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://camera" class="newsWidgetIcon"/>
                                    <Text text="Último Post" class="newsWidgetTitle"/>
                                </HBox>
                                <VBox class="lastPostBody">
                                    <VBox class="igPostCropContainer igPostLarge">
                                        <core:HTML
                                            id="igPost1"
                                            sanitizeContent="false"
                                            content="{mainModel>/igHtml1}"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- ══════════════════════════════
                             CENTRO: Noticias
                        ══════════════════════════════ -->
                        <VBox class="middleCol">
                            <VBox class="newsWidget">
                                <HBox class="newsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://newspaper" class="newsWidgetIcon"/>
                                    <Text text="Noticias" class="newsWidgetTitle"/>
                                </HBox>
                                <VBox class="newsWidgetBody newsListBody">

                                    <!-- Grupo fecha 10 May -->
                                    <VBox class="newsDateGroup">
                                        <HBox class="newsDateHeader" justifyContent="End" alignItems="Center">
                                            <Text text="10 May 2026" class="newsDateLabel"/>
                                        </HBox>
                                        <HBox class="newsCard newsCardRed" alignItems="Stretch">
                                            <VBox class="newsCardEmojiBox newsCardEmojiRed" justifyContent="Center" alignItems="Center">
                                                <Text text="🏥" class="newsCardEmoji"/>
                                            </VBox>
                                            <VBox class="newsCardContent" justifyContent="Center">
                                                <Text text="COMUNICADO LESIÓN" class="newsCardTitle" wrapping="false"/>
                                                <Text text="Pato se perderá las próximas 3 jornadas" class="newsCardSubtitle" wrapping="true"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                    <!-- Grupo fecha 9 May -->
                                    <VBox class="newsDateGroup">
                                        <HBox class="newsDateHeader" justifyContent="End" alignItems="Center">
                                            <Text text="9 May 2026" class="newsDateLabel"/>
                                        </HBox>
                                        <HBox class="newsCard newsCardBlue" alignItems="Stretch">
                                            <VBox class="newsCardEmojiBox newsCardEmojiBlue" justifyContent="Center" alignItems="Center">
                                                <Text text="👕" class="newsCardEmoji"/>
                                            </VBox>
                                            <VBox class="newsCardContent" justifyContent="Center">
                                                <Text text="COMUNICADO JUGADOR" class="newsCardTitle" wrapping="false"/>
                                                <Text text="Adiós sergi, gracias por nada" class="newsCardSubtitle" wrapping="true"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- ══════════════════════════════
                             DERECHA: Clasificación + Partidos
                        ══════════════════════════════ -->
                        <VBox class="rightCol">

                            <!-- CLASIFICACIÓN -->
                            <VBox class="standingsWidget fitStandings">
                                <HBox class="standingsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://performance" class="standingsHeaderIcon"/>
                                    <Text text="Clasificación" class="standingsHeaderTitle"/>
                                </HBox>
                                <VBox class="standingsTableWrapper">
                                    <HBox class="standingsTHead">
                                        <Text text="Pos"    width="36px"  class="sTH"/>
                                        <Text text="Equipo" width="125px" class="sTH"/>
                                        <Text text="Pts"    width="48px"  class="sTH sTHCenter"/>
                                        <Text text="PJ"     width="48px"  class="sTH sTHCenter"/>
                                        <Text text="DG"     width="54px"  class="sTH sTHCenter"/>
                                        <Text text="ÚLTIMOS 5"     width="30px"  class="sTH sTHCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="5º"        width="36px"  class="sTD"/>
                                        <Text text="Yellow FC" width="125px" class="sTD sTDTeam"/>
                                        <Text text="33"        width="48px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="48px"  class="sTD sTDCenter"/>
                                        <Text text="+5"        width="54px"  class="sTD sTDCenter sTDDGPos"/>
                                    </HBox>
                                    <HBox class="standingsTRow standingsTRowOwn">
                                        <Text text="6º"         width="36px"  class="sTD sTDOwn"/>
                                        <Text text="Choc. Sexy" width="125px" class="sTD sTDTeam sTDOwn"/>
                                        <Text text="30"         width="48px"  class="sTD sTDCenter sTDOwn"/>
                                        <Text text="22"         width="48px"  class="sTD sTDCenter sTDOwn"/>
                                        <Text text="-3"         width="54px"  class="sTD sTDCenter sTDDGNeg sTDOwn"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="7º"        width="36px"  class="sTD"/>
                                        <Text text="Equipo F"  width="125px" class="sTD sTDTeam"/>
                                        <Text text="28"        width="48px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="48px"  class="sTD sTDCenter"/>
                                        <Text text="-11"       width="54px"  class="sTD sTDCenter sTDDGNeg"/>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- ÚLTIMO PARTIDO -->
                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://history" class="matchWidgetIcon"/>
                                    <Text text="Último Partido" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center">
                                    <Text text="Jornada 21" class="matchJornada"/>
                                    <HBox justifyContent="SpaceAround" width="100%" class="matchTeamsRow">

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/logo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <HBox alignItems="Center" justifyContent="Center" class="matchScoreBox">
                                                <Text text="1" class="matchScoreNum"/>
                                                <Text text=" – " class="matchScoreDash"/>
                                                <Text text="2" class="matchScoreNum"/>
                                            </HBox>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="VFC" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="VFC United" class="matchTeamName"/>
                                        </VBox>

                                    </HBox>
                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <HBox justifyContent="Center" alignItems="Center" class="matchInfoRow">
                                            <Text text="📅 Dom, 22 Feb" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ 18:00" class="matchInfoText"/>
                                        </HBox>
                                        <Text text="📍 Estadio Nuevo" class="matchInfoText"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- PRÓXIMO PARTIDO -->
                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://future" class="matchWidgetIcon"/>
                                    <Text text="Próximo Partido" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center">
                                    <Text text="Jornada 22" class="matchJornada"/>
                                    <HBox justifyContent="SpaceAround" width="100%" class="matchTeamsRow">

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/logo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <Text text="VS" class="matchVsText"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="AC" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="Águilas City" class="matchTeamName"/>
                                        </VBox>

                                    </HBox>
                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <HBox justifyContent="Center" alignItems="Center" class="matchInfoRow">
                                            <Text text="📅 Dom, 01 Mar" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ 17:00" class="matchInfoText"/>
                                        </HBox>
                                        <Text text="📍 Campo Municipal" class="matchInfoText"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                        </VBox>

                    </HBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>

</mvc:View>