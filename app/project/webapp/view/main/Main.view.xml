<mvc:View
    controllerName="chocolatesexy.project.controller.main.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>

            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">
                    <HBox wrap="Wrap" class="mainGrid">

                        <VBox class="leftCol">
                            <VBox class="lastPostWidget">
                                <HBox class="newsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://camera" class="newsWidgetIcon"/>
                                    <Text text="{i18n>main.lastPost}" class="newsWidgetTitle"/>
                                </HBox>
                                <VBox class="lastPostBody">
                                    <VBox class="igPostCropContainer igPostLarge">
                                        <core:HTML
                                            id="igPost1"
                                            sanitizeContent="false"
                                            content="{mainModel>/igPostHtml}"/>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <VBox class="middleCol">
                            <VBox class="newsWidget">
                                <HBox class="newsWidgetHeader2" justifyContent="Center">
                                    <core:Icon src="sap-icon://newspaper" class="newsWidgetIcon"/>
                                    <Text text="{i18n>main.news}" class="newsWidgetTitle2"/>
                                </HBox>

                                <VBox class="newsWidgetBody newsListBody">
                                    <core:HTML
                                        id="mainNewsHtml"
                                        sanitizeContent="false"
                                        content="{mainModel>/newsHtml}"/>
                                </VBox>

                            </VBox>
                        </VBox>

                        <VBox class="rightCol">

                            <VBox class="standingsWidget fitStandings">
                                <HBox class="standingsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://performance" class="standingsHeaderIcon"/>
                                    <Text text="{i18n>main.leaderboard}" class="standingsHeaderTitle"/>
                                </HBox>
                                <VBox class="standingsTableWrapper">
                                    <core:HTML
                                        id="mainMiniStandings"
                                        sanitizeContent="false"
                                        content="{mainModel>/standingsHtml}"/>
                                </VBox>
                            </VBox>

                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://history" class="matchWidgetIcon"/>
                                    <Text text="{i18n>main.lastMatch}" class="matchWidgetTitle"/>
                                </HBox>

                                <VBox class="matchWidgetBody" alignItems="Center" visible="{mainModel>/hayUltimo}">

                                    <Text text="Jornada {mainModel>/ultimoPartido/jornada}"
                                          class="matchJornada"/>

                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%"
                                          visible="{= !${mainModel>/ultimoPartido/esLocal} }">
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/escudo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <HBox alignItems="Center" justifyContent="Center" class="matchScoreBox">
                                                <Text text="{mainModel>/ultimoPartido/golesNuestros}" class="matchScoreNum"/>
                                                <Text text=" – " class="matchScoreDash"/>
                                                <Text text="{mainModel>/ultimoPartido/golesRival}" class="matchScoreNum"/>
                                            </HBox>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{mainModel>/ultimoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{mainModel>/ultimoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>

                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%"
                                          visible="{mainModel>/ultimoPartido/esLocal}">
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{mainModel>/ultimoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{mainModel>/ultimoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <HBox alignItems="Center" justifyContent="Center" class="matchScoreBox">
                                                <Text text="{mainModel>/ultimoPartido/golesRival}" class="matchScoreNum"/>
                                                <Text text=" – " class="matchScoreDash"/>
                                                <Text text="{mainModel>/ultimoPartido/golesNuestros}" class="matchScoreNum"/>
                                            </HBox>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/escudo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>

                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <Text text="{mainModel>/ultimoPartido/fechaTexto}" class="matchInfoText"/>
                                        <Text text="📍 {mainModel>/ultimoPartido/ubicTxt}" class="matchInfoText"/>
                                    </VBox>

                                </VBox>

                                <Text text="{i18n>calendar.noLastMatch}" class="calNoData"
                                      visible="{= !${mainModel>/hayUltimo} }"/>
                            </VBox>

                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://future" class="matchWidgetIcon"/>
                                    <Text text="{i18n>main.nextMatch}" class="matchWidgetTitle"/>
                                </HBox>

                                <VBox class="matchWidgetBody" alignItems="Center" visible="{mainModel>/hayProximo}">

                                    <Text text="Jornada {mainModel>/proximoPartido/jornada} · Temporada {mainModel>/proximoPartido/temporadaNombre}"
                                          class="matchJornada"/>

                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%"
                                          visible="{= !${mainModel>/proximoPartido/esLocal} }">
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/escudo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <Text text="VS" class="matchVsText"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{mainModel>/proximoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{mainModel>/proximoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>

                                    <HBox class="matchTeamsRow" justifyContent="SpaceAround" width="100%"
                                          visible="{mainModel>/proximoPartido/esLocal}">
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="{mainModel>/proximoPartido/rivalIniciales}" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="{mainModel>/proximoPartido/rivalNombre}" class="matchTeamName"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <Text text="VS" class="matchVsText"/>
                                        </VBox>
                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/escudo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>
                                    </HBox>

                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <Text text="{mainModel>/proximoPartido/fechaTexto}" class="matchInfoText"/>
                                        <Text text="📍 {mainModel>/proximoPartido/ubicTxt}" class="matchInfoText"/>
                                    </VBox>

                                </VBox>

                                <Text text="{i18n>calendar.noNextMatch}" class="calNoData"
                                      visible="{= !${mainModel>/hayProximo} }"/>
                            </VBox>

                        </VBox>

                    </HBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>

        </content>
    </Page>

</mvc:View>