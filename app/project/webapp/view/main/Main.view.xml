<mvc:View
    controllerName="chocolatesexy.project.controller.main.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    displayBlock="true">

    <Page showHeader="false" enableScrolling="true" class="csPage">
        <content>
            <VBox class="pageWrapper" width="100%">

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Header" type="XML"/>

                <VBox class="pageContent">
                    <HBox wrap="Wrap" class="mainGrid">

                        <!-- ══════════════════════════════
                             IZQUIERDA: Clasificación
                        ══════════════════════════════ -->
                        <VBox class="leftCol">
                            <VBox class="standingsWidget">
                                <HBox class="standingsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://performance" class="standingsHeaderIcon"/>
                                    <Text text="Clasificación" class="standingsHeaderTitle"/>
                                </HBox>
                                <VBox class="standingsTableWrapper">
                                    <HBox class="standingsTHead">
                                        <Text text="Pos"    width="50px"  class="sTH"/>
                                        <Text text="Equipo" width="165px" class="sTH"/>
                                        <Text text="Pts"    width="60px"  class="sTH sTHCenter"/>
                                        <Text text="PJ"     width="60px"  class="sTH sTHCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="1º"        width="50px"  class="sTD"/>
                                        <Text text="Equipo A"  width="165px" class="sTD sTDTeam"/>
                                        <Text text="45"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="2º"        width="50px"  class="sTD"/>
                                        <Text text="Equipo B"  width="165px" class="sTD sTDTeam"/>
                                        <Text text="42"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="3º"        width="50px"  class="sTD"/>
                                        <Text text="Equipo C"  width="165px" class="sTD sTDTeam"/>
                                        <Text text="38"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="4º"        width="50px"  class="sTD"/>
                                        <Text text="Equipo D"  width="165px" class="sTD sTDTeam"/>
                                        <Text text="35"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="5º"        width="50px"  class="sTD"/>
                                        <Text text="Yellow FC" width="165px" class="sTD sTDTeam"/>
                                        <Text text="33"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow standingsTRowOwn">
                                        <Text text="6º"         width="50px"  class="sTD sTDOwn"/>
                                        <Text text="Choc. Sexy" width="165px" class="sTD sTDTeam sTDOwn"/>
                                        <Text text="30"         width="60px"  class="sTD sTDCenter sTDOwn"/>
                                        <Text text="22"         width="60px"  class="sTD sTDCenter sTDOwn"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="7º"        width="50px"  class="sTD"/>
                                        <Text text="Equipo F"  width="165px" class="sTD sTDTeam"/>
                                        <Text text="28"        width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"        width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                    <HBox class="standingsTRow">
                                        <Text text="8º"         width="50px"  class="sTD"/>
                                        <Text text="VFC United" width="165px" class="sTD sTDTeam"/>
                                        <Text text="20"         width="60px"  class="sTD sTDCenter"/>
                                        <Text text="22"         width="60px"  class="sTD sTDCenter"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- ══════════════════════════════
                             CENTRO: Noticias
                        ══════════════════════════════ -->
                        <VBox class="middleCol">
                            <VBox class="newsWidget">
                                <HBox class="newsWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://newspaper" class="newsWidgetIcon"/>
                                    <Text text="Noticias" class="newsWidgetTitle"/>
                                </HBox>
                                <VBox class="newsWidgetBody">

                                    <!-- ── POST 1 ── -->
                                    <VBox class="csNewsPost">
                                        <HBox class="csNewsPostHeader" justifyContent="SpaceBetween" alignItems="Center">
                                            <Text text="Últimas novedades del club" class="csNewsPostTitle"/>
                                            <Text text="10 May 2026" class="csNewsPostDate"/>
                                        </HBox>
                                        <VBox class="igPostCropContainer">
                                            <core:HTML
                                                id="igPost1"
                                                sanitizeContent="false"
                                                content="{mainModel>/igHtml1}"/>
                                        </VBox>

                                    </VBox>

                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- ══════════════════════════════
                             DERECHA: Partidos
                        ══════════════════════════════ -->
                        <VBox class="rightCol">

                            <!-- ÚLTIMO PARTIDO -->
                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://history" class="matchWidgetIcon"/>
                                    <Text text="Último Partido" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center">
                                    <Text text="Jornada 21" class="matchJornada"/>
                                    <HBox justifyContent="SpaceAround"  width="100%" class="matchTeamsRow">

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/logo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <HBox alignItems="Center" justifyContent="Center" class="matchScoreBox">
                                                <Text text="1" class="matchScoreNum"/>
                                                <Text text=" – " class="matchScoreDash"/>
                                                <Text text="2" class="matchScoreNum"/>
                                            </HBox>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="VFC" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="VFC United" class="matchTeamName"/>
                                        </VBox>

                                    </HBox>
                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <HBox justifyContent="Center" alignItems="Center" class="matchInfoRow">
                                            <Text text="📅 Dom, 22 Feb" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ 18:00" class="matchInfoText"/>
                                        </HBox>
                                        <Text text="📍 Estadio Nuevo" class="matchInfoText"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- PRÓXIMO PARTIDO -->
                            <VBox class="matchWidget">
                                <HBox class="matchWidgetHeader" justifyContent="Center">
                                    <core:Icon src="sap-icon://future" class="matchWidgetIcon"/>
                                    <Text text="Próximo Partido" class="matchWidgetTitle"/>
                                </HBox>
                                <VBox class="matchWidgetBody" alignItems="Center">
                                    <Text text="Jornada 22" class="matchJornada"/>
                                    <HBox justifyContent="SpaceAround" width="100%" class="matchTeamsRow">

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <Image src="images/logo.png" class="matchTeamLogo" densityAware="false"/>
                                            <Text text="Chocolate Sexy" class="matchTeamName"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchCenterBox">
                                            <Text text="VS" class="matchVsText"/>
                                        </VBox>

                                        <VBox alignItems="Center" class="matchTeamBox">
                                            <VBox class="matchTeamLogoPlaceholder" alignItems="Center" justifyContent="Center">
                                                <Text text="AC" class="matchTeamLogoInitials"/>
                                            </VBox>
                                            <Text text="Águilas City" class="matchTeamName"/>
                                        </VBox>

                                    </HBox>
                                    <VBox alignItems="Center" class="matchInfoDetails" width="100%">
                                        <HBox justifyContent="Center" alignItems="Center" class="matchInfoRow">
                                            <Text text="📅 Dom, 01 Mar" class="matchInfoText"/>
                                            <Text text=" · " class="matchInfoDot"/>
                                            <Text text="⏰ 17:00" class="matchInfoText"/>
                                        </HBox>
                                        <Text text="📍 Campo Municipal" class="matchInfoText"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                        </VBox>

                    </HBox>
                </VBox>

                <core:Fragment fragmentName="chocolatesexy.project.view.shared.Footer" type="XML"/>

            </VBox>
        </content>
    </Page>

</mvc:View>