<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

        <VBox class="dokkanHeader">

        <HBox alignItems="Center" class="navBar">

            <Image src="images/logo.png" class="navLogo" press=".onNavMain"/>

            <HBox justifyContent="Center" alignItems="Center" wrap="Wrap" class="navButtons">
                <Button text="{i18n>header.nav.plantilla}"     class="navBtn" press=""/>
                <Button text="{i18n>header.nav.calendario}"  class="navBtn" press=""/>
                <Button text="{i18n>header.nav.clasificacion}" class="navBtn" press=""/>
                <Button text="{i18n>header.nav.estadisticas}" class="navBtn" press=""/>
                <Button text="{i18n>header.nav.encuestas}" class="navBtn" press=""/>
 
            </HBox>

            <HBox alignItems="Center" class="navIcons">
                <Button icon="sap-icon://person-placeholder" class="navIconBtn" press=""/>
                <Button icon="sap-icon://action-settings"    class="navIconBtn" press=""/>
                <MenuButton icon="sap-icon://world" class="navBtn navLangBtn">
                    <Menu>
                        <MenuItem text="🇬🇧  English" press=""/>
                        <MenuItem text="🇪🇸  Español" press=""/>
                    </Menu>
                </MenuButton>
            </HBox>

        </HBox>

    </VBox>

</core:FragmentDefinition>