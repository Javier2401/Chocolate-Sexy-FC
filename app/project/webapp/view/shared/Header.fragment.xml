<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="csHeader">

        <HBox alignItems="Center" class="navBar">

            <Image src="images/escudo.png" class="navLogo" press=".onNavMain"/>

            <HBox justifyContent="Center" alignItems="Center" wrap="Wrap" class="navButtons">
                <Button text="{i18n>header.nav.plantilla}"     class="navBtn" press=".onNavSquad"/>
                <Button text="{i18n>header.nav.calendario}"    class="navBtn" press=".onNavCalendar"/>
                <Button text="{i18n>header.nav.clasificacion}" class="navBtn" press=".onNavLeaderboard"/>
                <Button text="{i18n>header.nav.estadisticas}"  class="navBtn" press=".onNavStats"/>
                <Button text="{i18n>header.nav.encuestas}"     class="navBtn" press=".onNavSurveys"/>
            </HBox>

            <HBox alignItems="Center" class="navIcons">
                <Button icon="sap-icon://person-placeholder" class="navIconBtn" press=".onNavProfile"/>
                <Button icon="sap-icon://action-settings"    class="navIconBtn" press=".onNavSettings"/>
                <MenuButton icon="sap-icon://world" class="navBtn navLangBtn">
                    <Menu>
                        <MenuItem text="🇬🇧  English" press=""/>
                        <MenuItem text="🇪🇸  Español" press=""/>
                    </Menu>
                </MenuButton>
            </HBox>

        </HBox>

    </VBox>

</core:FragmentDefinition>